<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>atf.api</groupId>
        <artifactId>atf</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>
    <artifactId>atf-reporting-tests</artifactId>
    <name>ATF Reporting Composition Tests</name>
    <description>API/UI/E2E composition suite consuming standalone atf-reporting.</description>
    <properties>
        <atf.reporting.test.version>${project.version}</atf.reporting.test.version>
    </properties>
    <dependencies>
        <dependency><groupId>atf.api</groupId><artifactId>atf-reporting</artifactId><version>${atf.reporting.test.version}</version><scope>test</scope></dependency>
        <dependency><groupId>atf.api</groupId><artifactId>atf-core</artifactId><version>${project.version}</version><scope>test</scope></dependency>
        <dependency><groupId>atf.api</groupId><artifactId>atf-mock</artifactId><version>${project.version}</version><scope>test</scope></dependency>
        <dependency><groupId>atf.api</groupId><artifactId>atf-validation</artifactId><version>${project.version}</version><scope>test</scope></dependency>
        <dependency><groupId>atf.api</groupId><artifactId>atf-console</artifactId><version>${project.version}</version><scope>test</scope></dependency>
        <dependency><groupId>atf.api</groupId><artifactId>atf-ui</artifactId><version>${project.version}</version><scope>test</scope></dependency>
        <dependency><groupId>atf.api</groupId><artifactId>atf-debug-ui</artifactId><version>${project.version}</version><scope>test</scope></dependency>
        <dependency><groupId>atf.api</groupId><artifactId>atf-test-kit</artifactId><version>${project.version}</version><scope>test</scope></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
        <dependency><groupId>org.junit.platform</groupId><artifactId>junit-platform-suite</artifactId><scope>test</scope></dependency>
    </dependencies>
    <profiles>
        <profile>
            <id>reporting-release</id>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.2</version>
                <configuration>
                    <includes>
                        <include>**/AtfReportingUnitSuite.java</include>
                        <include>**/AtfReportingBrowserSuite.java</include>
                    </includes>
                    <failIfNoTests>true</failIfNoTests>
                </configuration>
            </plugin></plugins></build>
        </profile>
        <profile>
            <id>library-guides</id>
            <build><plugins><plugin>
                <groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.2</version>
                <configuration>
                    <systemPropertyVariables>
                        <junit.jupiter.tempdir.cleanup.mode.default>NEVER</junit.jupiter.tempdir.cleanup.mode.default>
                    </systemPropertyVariables>
                    <includes><include>**/*LibraryGuideIT.java</include></includes>
                    <failIfNoTests>true</failIfNoTests>
                </configuration>
            </plugin></plugins></build>
        </profile>
    </profiles>
</project>
